---
import { Code } from 'astro:components';
import { readLeanSource } from '../lib/leanSource';
interface Props { file: string; region?: string; }
const { file, region } = Astro.props;
const code = readLeanSource(file, region);
---
<figure class="lean-source">
  <figcaption><span>{file}</span><button type="button" data-lean-copy data-code={code} aria-label={`複製 ${file} 的程式碼`}>複製程式碼</button></figcaption>
  <Code code={code} lang="lean4" theme="github-light" />
  <span class="copy-feedback" aria-live="polite"></span>
</figure>
<script>
  import '../scripts/copy';
</script>
